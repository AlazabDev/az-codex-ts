# Server-side only. Copy values into the application service's environment.
# Existing Foundry, Supabase and gateway variables remain unchanged.
OLLAMA_BASE_URL=https://ollama.alazab.com
OLLAMA_AUTH_USER=azureuser
OLLAMA_AUTH_PASS=

# Alternative: use http://127.0.0.1:11434 when the application runs directly
# on azab-orchestrator. For local unauthenticated access, leave both Basic
# variables empty. 127.0.0.1 inside a bridge-network container is that container.

# Optional Bearer auth for other gateways. A complete Basic pair takes precedence.
OLLAMA_API_KEY=

# Real generation checks can take longer on CPU, especially on the first load.
OLLAMA_TEST_TIMEOUT_SECONDS=300
